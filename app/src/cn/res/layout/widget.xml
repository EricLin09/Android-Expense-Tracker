<?xml version="1.0" encoding="utf-8"?>
<!--
  国内版 2×1 小组件：固定两行「今日支出 / 本月支出」。

  为什么不跟随设置里的「结余 / 总支出」：2×1 只有 40~50dp 高，装不下月份、支出、
  收入、大数字四项——之前挤在一行的方案要么截断要么省略。改成两行各自语义固定，
  信息密度更高，也不需要用户先理解"大数字现在代表什么"。

  每行是「标签靠左 + 金额靠右」，金额 wrap_content 优先取宽，标签可被压缩。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingHorizontal="14dp"
    android:paddingVertical="7dp">

    <!-- 今日支出 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日支出"
            android:textColor="#A6FFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/wToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="¥0.00"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <!-- 本月支出 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="本月支出"
            android:textColor="#A6FFFFFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/wMonthExp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="¥0.00"
            android:textColor="#EFB4A8"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:fontFeatureSettings="tnum" />
    </LinearLayout>
</LinearLayout>
