<?xml version="1.0" encoding="utf-8"?>
<!--
  深石墨蓝底，单层垂直渐变。

  旧版是「135° 底色渐变 + 270° 白色高光」两层：两个渐变方向互相打架，那种玻璃
  高光也是偏旧的手法。改成单一垂直渐变、去掉高光层，并整体压深一档——小组件落在
  任意壁纸上，底色越深越不挑背景。

  圆角保持 24dp，与旧版一致，不影响已有布局。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#33414F"
        android:endColor="#212B36"
        android:angle="270" />
    <corners android:radius="24dp" />
</shape>
